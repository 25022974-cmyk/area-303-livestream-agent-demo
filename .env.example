# ============================================================
# AREA_303 — Cấu hình AI / LLM (GLM-5.2 qua proxy Anthropic-Messages)
# ============================================================
# Copy file nay thanh .env roi dien gia tri that. File .env KHONG duoc
# commit (da them vao .gitignore).
#
# Proxy phai tuong thich Anthropic Messages API:
#   POST  {AI_PROXY_BASE_URL}{AI_API_PATH}      (mac dinh /v1/messages)
#   Header: Authorization: Bearer <AI_API_KEY>
#           anthropic-version: 2023-06-01
#           Content-Type: application/json
#   Body:   {"model": ..., "max_tokens": ..., "messages": [...],
#            "system": "<tuy chon>", "temperature": ...}
#   Response: data["content"][0]["text"]

# Base URL cua proxy (KHONG kem /v1/messages)
AI_PROXY_BASE_URL=https://ai.boltz.one/ai/anthropic

# API key nguoi dung cap (Bearer token)
AI_API_KEY=replace-with-your-key

# Ten model
AI_MODEL=GLM-5.2

# (Tuy chon) Duong dan endpoint, mac dinh /v1/messages
# AI_API_PATH=/v1/messages

# (Tuy chon) Phi ban Anthropic, mac dinh 2023-06-01
# AI_ANTHROPIC_VERSION=2023-06-01

# (Tuy chon) URL day du (ghi de AI_PROXY_BASE_URL+AI_API_PATH neu can)
# AI_API_URL=

# (Tuy chon) Max tokens sinh ra, mac dinh 1024
# AI_MAX_TOKENS=1024

# (Tuy chon) Timeout giay, mac dinh 30
# AI_TIMEOUT=30
