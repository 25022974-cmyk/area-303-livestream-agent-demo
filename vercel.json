{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "mockups/**,data/**,src/**"
    }
  },
  "routes": [
    { "src": "/(.*).css", "dest": "/api/index.py" },
    { "src": "/(.*).js", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
